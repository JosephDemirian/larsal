(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "{R}"))
(allow file-write* (subpath "{R_TMP}"))
(allow file-write* (literal "/dev/null"))
(deny network*)
(deny file-read* (subpath "{OWNER}/Library") (subpath "{OWNER}/.ssh") (subpath "/Library/Keychains") (subpath "/System/Library/Keychains") (subpath "/private/var/db/Keychains"))
(deny mach-lookup (global-name "com.apple.pboard") (global-name "com.apple.SecurityAgent") (global-name "com.apple.securityd") (global-name "com.apple.secd") (global-name "com.openssh.ssh-agent") (global-name "com.apple.sshd") (global-name "com.apple.CoreAuthentication.daemon") (global-name "com.apple.biometrickitd") (global-name "com.apple.ctkd"))
(deny mach-lookup (global-name-prefix "com.apple.pasteboard") (global-name-prefix "com.apple.pboard"))
